<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@color/ds_bg_warm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <!-- Top Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@color/ds_text_primary"
                android:visibility="gone" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chia sẻ món ngon"
                android:textColor="@color/ds_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:text="Một gợi ý nhỏ, thêm nhiều bữa ngon."
            android:textColor="@color/ds_text_secondary"
            android:textSize="13sp" />

        <!-- Form -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tên món *"
            android:textColor="@color/ds_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPostFoodName"
            style="?attr/textInputStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:hintEnabled="false">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtPostFoodName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Món ngon hôm nay"
                android:paddingVertical="14dp"
                android:paddingHorizontal="16dp"
                android:textColor="@color/ds_text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Nội dung *"
            android:textColor="@color/ds_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPostNote"
            style="?attr/textInputStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:hintEnabled="false">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtPostNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Một gợi ý cho bữa ăn chỉ 20,000 VNĐ. Bạn đã thử chưa?"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:padding="16dp"
                android:gravity="top|start"
                android:textColor="@color/ds_text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Giá tham khảo (VNĐ)"
            android:textColor="@color/ds_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPostPrice"
            style="?attr/textInputStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:hintEnabled="false">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtPostPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ví dụ: 20,000"
                android:inputType="number"
                android:paddingVertical="14dp"
                android:paddingHorizontal="16dp"
                android:textColor="@color/ds_text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Địa điểm"
            android:textColor="@color/ds_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPostRestaurant"
            style="?attr/textInputStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:hintEnabled="false"
            app:endIconDrawable="@android:drawable/ic_dialog_map"
            app:endIconMode="custom">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtPostRestaurant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Tên quán / địa chỉ"
                android:paddingVertical="14dp"
                android:paddingHorizontal="16dp"
                android:textColor="@color/ds_text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Thêm ảnh món ăn button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickPostImage"
            style="@style/Widget.Homnayangi.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Thêm ảnh món ăn"
            android:textAllCaps="false"
            app:icon="@android:drawable/ic_menu_gallery"
            app:iconGravity="textStart"
            app:iconTint="@color/ds_text_primary" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPostPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/ds_border"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/imgPostPreview"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:scaleType="centerCrop"
                android:adjustViewBounds="true" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="* Thông tin bắt buộc. Chia sẻ trải nghiệm thật và tôn trọng mọi người."
            android:textColor="@color/ds_text_secondary"
            android:textSize="11sp" />

        <!-- Actions -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitPost"
            style="?attr/materialButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Đăng bài viết"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelPost"
            style="@style/Widget.Homnayangi.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Hủy"
            android:textAllCaps="false" />

    </LinearLayout>
</ScrollView>
