<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="@color/ds_surface"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/ds_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Hàng 1: Tên + Giá -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvFoodName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/tvPrice"
                android:layout_marginEnd="8dp"
                android:text="Bánh Mì Thịt Nướng"
                android:textColor="@color/ds_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="25,000 VNĐ"
                android:textColor="@color/ds_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Hàng 2: Danh mục -->
        <TextView
            android:id="@+id/tvCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Đồ ăn nhanh"
            android:textColor="@color/ds_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvFoodRecipe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Công thức..."
            android:textColor="@color/ds_text_secondary"
            android:textSize="13sp"
            android:maxLines="0"
            android:ellipsize="end"
            android:visibility="gone" />

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <!-- Hàng 3: Hành động -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Nút Sửa (Cả thẻ cũng click được nhưng thêm nút cho rõ) -->
            <LinearLayout
                android:id="@+id/btnEditAction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_edit"
                    app:tint="@color/ds_text_secondary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Sửa"
                    android:textColor="@color/ds_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Nút Yêu thích -->
            <LinearLayout
                android:id="@+id/btnFavoriteAction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/imgFavorite"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/btn_star_big_off"
                    app:tint="@color/ds_text_secondary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Yêu thích"
                    android:textColor="@color/ds_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Nút Xóa -->
            <LinearLayout
                android:id="@+id/btnDeleteAction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/imgDelete"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_delete"
                    app:tint="@color/ds_text_secondary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Xóa"
                    android:textColor="@color/ds_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Nút Tìm quán gần đây -->
            <LinearLayout
                android:id="@+id/btnFindRestaurantAction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_dialog_map"
                    app:tint="@color/ds_primary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Quán"
                    android:textColor="@color/ds_primary"
                    android:textStyle="bold"
                    android:textSize="13sp" />
            </LinearLayout>
            
            <!-- Nút Thêm vào vòng quay -->
            <LinearLayout
                android:id="@+id/btnAddToRouletteAction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical|end"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/imgAddToRoulette"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_input_add"
                    app:tint="@color/ds_text_secondary" />
                <TextView
                    android:id="@+id/tvAddToRoulette"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Quay"
                    android:textColor="@color/ds_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
