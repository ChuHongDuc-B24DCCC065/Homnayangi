<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_bg_warm">

    <!-- ===== HEADER ===== -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@color/ds_primary"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingVertical="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎰 FOOD ROULETTE"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hôm nay ăn gì?"
            android:textColor="#FFECE0"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- ===== POOL: Món đã chọn ===== -->
    <LinearLayout
        android:id="@+id/layoutPool"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/layoutHeader"
        android:background="@color/ds_surface"
        android:elevation="1dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🎯 Món trong vòng quay"
                android:textColor="@color/ds_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnClearPool"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:text="Xóa tất cả"
                android:textColor="@color/ds_warning_delete"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Hướng dẫn khi pool trống -->
        <TextView
            android:id="@+id/tvPoolEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:padding="4dp"
            android:text="Chưa có món nào → Sang tab 🍽️ Món ăn và nhấn ＋"
            android:textColor="@color/ds_text_secondary"
            android:textSize="12sp" />

        <!-- Chips của pool -->
        <HorizontalScrollView
            android:id="@+id/scrollPool"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/linearPool"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- ===== SPIN BUTTON ===== -->
    <LinearLayout
        android:id="@+id/layoutBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="16dp">

        <!-- Toggle loại trừ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🚫 Loại trừ món đã quay"
                android:textColor="@color/ds_text_secondary"
                android:textSize="12sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchEliminate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:thumbTint="@color/ds_primary"
                app:trackTintMode="src_in" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSpin"
            style="?attr/materialButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="🎲 QUAY NGAY"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ===== VÒNG QUAY + KẾT QUẢ ===== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/layoutBottom"
        android:layout_below="@id/layoutPool"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="16dp">

            <!-- Vòng quay -->
            <FrameLayout
                android:layout_width="280dp"
                android:layout_height="280dp">

                <com.example.homnayangi.utils.RouletteWheelView
                    android:id="@+id/wheelView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Mũi tên -->
                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="-10dp"
                    android:src="@android:drawable/arrow_down_float"
                    app:tint="@color/ds_primary" />
            </FrameLayout>

            <!-- Card kết quả -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="32dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/ds_surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/ds_border"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/tvSelectedFood"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="16dp"
                    android:text="Nhấn QUAY NGAY để chọn món! 🍽️"
                    android:textColor="@color/ds_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Lịch sử quay gần nhất -->
            <LinearLayout
                android:id="@+id/layoutRecentResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="32dp"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🕐 Kết quả gần đây"
                    android:textColor="@color/ds_text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvRecentResults"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ds_text_secondary"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ===== CONFETTI OVERLAY ===== -->
    <com.example.homnayangi.utils.ConfettiView
        android:id="@+id/confettiView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

</RelativeLayout>
