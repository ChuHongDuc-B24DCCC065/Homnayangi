<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_bg_warm"
    android:paddingTop="32dp">

    <!-- Top Section -->
    <LinearLayout
        android:id="@+id/layoutTopSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cộng đồng"
            android:textColor="@color/ds_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="Chia sẻ bữa ngon, khám phá cùng nhau."
            android:textColor="@color/ds_text_secondary"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTopPost"
            style="?attr/materialButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Chia sẻ món ngon"
            android:textAllCaps="false"
            app:icon="@android:drawable/ic_menu_edit"
            app:iconGravity="textStart"
            app:iconTint="@color/white" />

        <!-- Banner mời đăng nhập (chỉ hiện khi là guest) -->
        <LinearLayout
            android:id="@+id/bannerLoginPrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_dialog_rounded"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🔒  Đăng nhập để chia sẻ món ngon"
                android:textColor="@color/ds_text_primary"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_media_next"
                app:tint="@color/ds_text_secondary" />
        </LinearLayout>

        <!-- Filter Chips (Mockup placeholders for now) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="8dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <!-- Can be populated programmatically later like FoodListFragment -->
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- RecyclerView bài đăng -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewCommunity"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layoutTopSection"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="24dp" />

    <!-- EMPTY STATE -->
    <LinearLayout
        android:id="@+id/layoutEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/layoutTopSection"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="40dp"
        android:layout_marginTop="80dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_avatar_placeholder">
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_dialog_email"
                app:tint="@color/ds_primary" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Chưa có bài viết nào"
            android:textColor="@color/ds_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textAlignment="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Bạn có món ngon muốn giới thiệu? Hãy là người đầu tiên chia sẻ với cộng đồng."
            android:textColor="@color/ds_text_secondary"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp"
            android:textAlignment="center" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEmptyPost"
            style="?attr/materialButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Viết bài đầu tiên"
            android:textAllCaps="false" />
    </LinearLayout>

</RelativeLayout>
